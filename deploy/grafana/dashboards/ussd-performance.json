        {"expr": "histogram_quantile(0.99, sum by (le) (rate(ussd_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
