      "id": 11,
      "title": "Failed Sessions",
      "type": "stat",
      "targets": [{"expr": "sum(ussd_sessions_total{state=\"FAILED\"})", "legendFormat": "failed", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
